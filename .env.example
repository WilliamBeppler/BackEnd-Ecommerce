# Modelo das variaveis de ambiente do back-end.
# Copie este arquivo para ".env" (na raiz do projeto) e troque pelos valores reais.
# O .env NAO vai para o Git; este .env.example vai, e nunca deve ter valor real.

# Senha do usuario do MySQL definido em spring.datasource.username
DB_PASSWORD=troque_pela_senha_do_mysql

# Chave que assina os tokens JWT: minimo 32 caracteres, aleatoria.
# Para gerar uma (Git Bash):  openssl rand -hex 48
JWT_SECRET=gere_uma_chave_aleatoria_com_no_minimo_32_caracteres

# Origens do front-end autorizadas no CORS, separadas por virgula (sem barra no final).
# localhost e 127.0.0.1 contam como origens diferentes.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:5501

# Cookie do token so por HTTPS? false em desenvolvimento (localhost), true em producao
COOKIE_SECURE=false

# Origens do painel de admin (unicas que podem alterar produtos). Tambem precisam estar em CORS_ORIGINS.
ADMIN_ORIGINS=http://localhost:5501
